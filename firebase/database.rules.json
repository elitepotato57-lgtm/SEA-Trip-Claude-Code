{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 30"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z2-9]{6}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "requests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['n'])"
        }
      }
    },
    "share": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "loc": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('share').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['lat', 'lng', 't']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('t').val() <= now)"
      }
    },
    "groups": {
      "$gid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "n": {
          ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists() && (newData.exists() || root.child('owner').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((root.child('owner').val() === auth.uid && root.child('groups').child($gid).child('members').child(auth.uid).exists()) || (root.child('groups').child($gid).child('members').child(auth.uid).exists() && !data.exists() && newData.exists()) || (!root.child('groups').child($gid).exists() && $uid === auth.uid))",
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)"
          }
        },
        "items": {
          "$iid": {
            ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['w', 'a', 'c', 'by', 'to', 't']) && newData.child('a').isNumber() && newData.child('a').val() > 0 && newData.child('t').val() <= now)"
          }
        }
      }
    },
    "mygroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$gid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('groups').child($gid).child('members').child(auth.uid).exists())"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || ($uid === auth.uid && !root.child('admins').exists()))",
        ".validate": "newData.isBoolean()"
      }
    },
    "owner": {
      ".read": "auth != null",
      ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('admins').child(auth.uid).val() === true"
    },
    "photos": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 40000 && newData.val().beginsWith('data:image/jpeg;base64,'))"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "parties": {
      "$pid": {
        ".read": "auth != null && data.child('m').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('m').child(auth.uid).exists() || (!data.exists() && newData.child('m').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['g', 'h', 'm'])"
      }
    },
    "tally": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "$game": {
          ".validate": "newData.hasChildren(['w', 'p']) && newData.child('w').isNumber() && newData.child('p').isNumber()"
        }
      }
    },
    "stickerIndex": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)"
      }
    },
    "stickers": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['n', 'd']) && newData.child('d').isString() && newData.child('d').val().length < 300000 && newData.child('d').val().beginsWith('data:image/'))"
      }
    },
    "phones": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('pallow').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^\\+[0-9]{7,15}$/))"
      }
    },
    "pallow": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['t', 'n']) && newData.child('t').val() <= now && (!newData.child('cl').exists() || newData.child('cl').val().beginsWith('https://')))"
        }
      }
    },
    "gkey": {
      ".read": "auth != null && (root.child('gkeyok').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 120)"
    },
    "gkeyok": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || newData.isBoolean()"
      }
    },
    "gkeyask": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "stats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "msgs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('f').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['f', 's', 't']) && newData.child('t').val() <= now)"
        }
      }
    }
  }
}
